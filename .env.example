# ==============================================================================
# OCB Auto-Earning — Admin Auth Service Environment Variables
# Sao chép file này thành .env để tùy chỉnh môi trường: cp .env.example .env
# ==============================================================================

# Server
SERVER_PORT=8081
APP_CONTEXT_PATH=/api
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=admin_auth_db
DB_USER=admin_user
DB_PASSWORD=admin_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_TIMEOUT=2000ms

# Apache Kafka, Schema Registry & Kafka UI
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_PORT=8082
SCHEMA_REGISTRY_URL=http://localhost:8082
KAFKA_UI_PORT=8090

# JWT Security
JWT_ISSUER=https://auth.autoeaning.ocb.com.vn
JWT_KEY_ID=ocb-admin-auth-key-1
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=86400
JWT_KEYS_DIR=./keys

# MFA Settings
MFA_ISSUER=OCB-AutoEarning-Admin
MFA_TOKEN_EXPIRATION_SECONDS=300

# Security Guardrails
SECURITY_MAX_FAILED_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION_MINUTES=30
SECURITY_SESSION_IDLE_TIMEOUT_MINUTES=30
SECURITY_MAX_CONCURRENT_SESSIONS=5

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000

# Outbox & Event Streaming
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_FIXED_DELAY_MS=500
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_MAX_ATTEMPTS=10
OUTBOX_CLEANER_RETENTION_DAYS=14
